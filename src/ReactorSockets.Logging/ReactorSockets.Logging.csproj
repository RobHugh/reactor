<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ReactorSockets.Logging</RootNamespace>
    <AssemblyName>ReactorSockets.Logging</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ReactorSockets.Logging</PackageId>
    <Description>Adapts the ReactorSockets diagnostic Sink to Microsoft.Extensions.Logging's ILogger. Shipped apart from ReactorSockets so the core takes no logging dependency.</Description>
    <Authors>Subterfuge Studios</Authors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReactorSockets\ReactorSockets.csproj" />
  </ItemGroup>

</Project>
