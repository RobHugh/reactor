<Project>

  <!--
    The build-time style and warning gate (#431). .editorconfig sets which IDE rules are warnings,
    EnforceCodeStyleInBuild reports them from the compiler, and TreatWarningsAsErrors fails the build
    on them and on every compiler and analyzer warning. NuGet audit warnings stay warnings: a newly
    published advisory against a dependency must not fail every build until the package is bumped.
  -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
